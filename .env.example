# Wirewise server configuration. Copy to `.env` (repo root or backend/) and edit.
# Placeholders only: never commit a real key. The key is read by the Python backend
# and is never sent to the browser.

# Gemini API key (https://aistudio.google.com/apikey). Leave empty to run in demo mode.
GEMINI_API_KEY=your-gemini-api-key-here

# auto = use Gemma 4 when a key is set, otherwise the demo provider
# gemma = require Gemma 4,  demo = always use the recorded demo fixtures
VISION_PROVIDER=auto

# gemma-4-31b-it (default) or gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-4-31b-it

# files = upload through the Gemini Files API (documented path for Gemma), inline = send bytes in the request
GEMMA_IMAGE_INPUT=files

# minimal or high
GEMMA_THINKING_LEVEL=minimal
GEMMA_TIMEOUT_SECONDS=120

# Uploads and sessions
MAX_UPLOAD_MB=10
SESSION_TTL_MINUTES=120

# Optional storage locations (defaults are inside backend/data)
# WIREWISE_DB_PATH=./backend/data/wirewise.db
# WIREWISE_SAVED_DIR=./backend/data/saved

# Browser origins allowed to call the API directly (the Next.js proxy does not need this)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend only: where the Next.js server proxies /api/* to
BACKEND_URL=http://127.0.0.1:8000
