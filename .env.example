# Wirewise server configuration. Copy to `.env` (repo root or backend/) and edit.
# Placeholders only: never commit a real key. Everything here is read by the Python
# backend; nothing is ever sent to the browser.

# Which Gemma 4 provider analyses photos. There is no "auto" mode and no silent fallback:
# if the chosen provider fails, the UI shows the error and nothing is analyzed.
#   gemini = hosted Gemma 4 through the Gemini API (set for this demo; needs GEMINI_API_KEY)
#   ollama = local Gemma 4 through Ollama (optional local path, see below)
#   demo   = TEST ONLY: scripted answers for the synthetic demo images, no model. Shows a DEMO MODE banner.
# (If VISION_PROVIDER is not set at all, the server defaults to ollama.)
VISION_PROVIDER=gemini

# --- Hosted Gemma 4 (Gemini API) ----------------------------------------------
# Key from https://aistudio.google.com/apikey . Server side only, never sent to the browser.
GEMINI_API_KEY=your-gemini-api-key-here
# gemma-4-31b-it (default) or gemma-4-26b-a4b-it
GEMINI_MODEL=gemma-4-31b-it
# files = Gemini Files API (documented path for Gemma), inline = send bytes in the request
GEMINI_IMAGE_INPUT=files
# minimal or high
GEMINI_THINKING_LEVEL=minimal

# --- Optional local Gemma 4 (Ollama), used when VISION_PROVIDER=ollama ----------
# Install Ollama (https://ollama.com/download), then:  ollama pull gemma4:e4b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# How long Ollama keeps the model in memory after a request
OLLAMA_KEEP_ALIVE=15m

# Seconds to wait for a model answer (one image per analysis, no retries).
# Hosted gemma-4-31b-it took 56-62 s per image in testing, so 60 s is too short for it; local CPU inference can be slower still.
GEMMA_TIMEOUT_SECONDS=180

# Uploads and sessions
MAX_UPLOAD_MB=10
SESSION_TTL_MINUTES=120

# Optional storage locations (defaults are inside backend/data)
# WIREWISE_DB_PATH=./backend/data/wirewise.db
# WIREWISE_SAVED_DIR=./backend/data/saved

# Browser origins allowed to call the API directly (the Vite dev proxy does not need this)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
