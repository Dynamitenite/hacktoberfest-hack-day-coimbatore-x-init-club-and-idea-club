# Wirewise server configuration. Copy to `.env` (repo root or backend/) and edit.
# Placeholders only: never commit a real key. Everything here is read by the Python
# backend; nothing is ever sent to the browser.

# Which Gemma 4 provider analyses photos. There is no "auto" mode and no silent fallback.
#   ollama = local Gemma 4 through Ollama (default)
#   gemini = hosted Gemma 4 through the Gemini API (optional; needs GEMINI_API_KEY)
#   demo   = TEST ONLY: scripted synthetic fixtures, no model. Shows a persistent DEMO MODE banner.
VISION_PROVIDER=ollama

# --- Local Gemma 4 (Ollama) -------------------------------------------------
# Install Ollama (https://ollama.com/download), then:  ollama pull gemma4:e4b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# How long Ollama keeps the model in memory after a request
OLLAMA_KEEP_ALIVE=15m

# --- Hosted Gemma 4 (Gemini API), only if VISION_PROVIDER=gemini -------------
GEMINI_API_KEY=your-gemini-api-key-here
# gemma-4-31b-it (default) or gemma-4-26b-a4b-it
GEMINI_MODEL=gemma-4-31b-it
# files = Gemini Files API (documented path for Gemma), inline = send bytes in the request
GEMINI_IMAGE_INPUT=files
# minimal or high
GEMINI_THINKING_LEVEL=minimal

# Seconds to wait for a model answer (one image per analysis, no retries)
GEMMA_TIMEOUT_SECONDS=60

# Uploads and sessions
MAX_UPLOAD_MB=10
SESSION_TTL_MINUTES=120

# Optional storage locations (defaults are inside backend/data)
# WIREWISE_DB_PATH=./backend/data/wirewise.db
# WIREWISE_SAVED_DIR=./backend/data/saved

# Browser origins allowed to call the API directly (the Vite dev proxy does not need this)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
